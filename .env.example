# Gmail SMTP Configuration
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASSWORD=tu-contraseña-de-aplicación

# Netlify deployment URL
SITE_URL=https://tu-dominio.netlify.app

# Cloudflare Turnstile (get from https://dash.cloudflare.com/?to=/:account/turnstile)
TURNSTILE_SECRET_KEY=tu-clave-secreta-de-turnstile
VITE_TURNSTILE_SITE_KEY=tu-clave-publica-de-turnstile

# Optional: override the contact form endpoint (default: /.netlify/functions/send-email)
# Useful if you deploy the backend elsewhere or use `netlify dev`
VITE_CONTACT_ENDPOINT=